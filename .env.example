# Copy to .env and fill in, then run:  uvicorn main:app --env-file .env
# .env is git-ignored. Never put these values in the Flutter app.

# --- Face verification (POST /api/verification/face) ---
# Cosine similarity at or above this passes. 0.363 is SFace's published value;
# raise it to be stricter (fewer false accepts, more retries).
FACE_MATCH_THRESHOLD=0.363
# Counted attempts per user per Philippine calendar day (HTTP 429 after).
FACE_MATCH_MAX_ATTEMPTS_PER_DAY=5
# Backend-only Cloudinary credentials for uploading a selfie that passed.
# Cloudinary console > Settings > API Keys. Without them the endpoint
# answers 503 not_configured and spends no attempts.
CLOUDINARY_CLOUD_NAME=dlk8chosr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FACE_FOLDER=face_verifications
# Optional: YuNet detection confidence (0..1) and model folder.
# FACE_DETECTION_SCORE_THRESHOLD=0.8
# FACE_MODELS_DIR=models

# --- Notifications and request expiration (defaults shown) ---
# NOTIFICATION_WORKER_ENABLED=true
# REQUEST_EXPIRATION_INTERVAL_SECONDS=3600

# DELETE /api/account: how recent the user's sign-in must be (seconds).
ACCOUNT_DELETE_MAX_AUTH_AGE_SECONDS=300
